# Public URL of the app (used in QR codes, Telegram links and redirects)
APP_URL=http://localhost:3000

# Secret for signing sessions and Telegram link tokens (32+ random chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Leave empty to use the embedded PGlite database in ./.data/pg.
# Set a PostgreSQL URL for a production / Postgres Docker deployment.
DATABASE_URL=
# Optional: override the embedded PGlite data directory (useful for tests/CI).
PGLITE_DATA_DIR=

# Docker compose only: PostgreSQL credentials and the public host port.
# Change the password before deploying. Use URL-safe characters or percent-encode it.
POSTGRES_DB=uzbook
POSTGRES_USER=uzbook
POSTGRES_PASSWORD=change-me-in-production
APP_PORT=3000

# Telegram bot (optional). Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Automatic payments.
# Test payments activate a plan for free. Set to "off" in production!
PAYMENTS_DEMO=off
# Payme merchant credentials (checkout + /api/payments/payme webhook)
PAYME_MERCHANT_ID=
PAYME_KEY=
# Optional comma-separated IP or CIDR allowlist for Payme webhook (e.g. 185.250.243.0/24)
PAYME_IP_ALLOWLIST=
# Click merchant credentials (checkout + /api/payments/click webhook)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Optional comma-separated IP or CIDR allowlist for Click webhook (e.g. 185.196.214.0/24)
CLICK_IP_ALLOWLIST=

# Real transfer details for the owner billing page. Leave empty until you have
# a real card/account; the page will then show only the support contact.
PAYMENT_DETAILS=
SUPPORT_TELEGRAM=@uzbook_support

# Show the demo login shortcuts. Local development shows them automatically;
# production hides them unless this is explicitly set to "on" (staging only).
SHOW_DEMO_ACCOUNTS=off

# First platform administrator. Used by `npm run admin:create`; the demo seed
# refuses to run in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор
